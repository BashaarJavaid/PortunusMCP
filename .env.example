# Local development values only — never commit a real .env (see .gitignore).
POSTGRES_USER=portunusmcp
POSTGRES_PASSWORD=portunusmcp
POSTGRES_DB=portunusmcp

# As seen from inside the Docker network. When running alembic/pytest on the
# host against the compose Postgres, swap the host to localhost:5432.
DATABASE_URL=postgresql+asyncpg://portunusmcp:portunusmcp@postgres:5432/portunusmcp
REDIS_URL=redis://redis:6379/0

# Item 39: one namespace per PortunusMCP deployment sharing a Docker daemon.
UPSTREAM_RUNTIME_NAMESPACE=portunusmcp-dev
# Required supplementary group for the non-root gateway to access docker.sock.
# Inspect the mounted socket (host metadata can differ under Docker Desktop):
# docker run --rm -v /var/run/docker.sock:/var/run/docker.sock docker:29.6.1-cli \
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=REPLACE_WITH_DOCKER_SOCKET_GID

# Only needed when running the demo policy (scripts/run_demo.py prints this run's
# value): the HMAC secret for the demo's `signed` ci-agent identity (item 34).
# PORTUNUSMCP_DEMO_SIGNING_SECRET=
