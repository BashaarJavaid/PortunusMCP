# Production Compose interpolation. Copy to .env.prod, chmod 0600, and replace
# every REPLACE_* value. This file is not injected wholesale into any container.

# Immutable service images. Obtain the gateway digest from its release job summary.
GATEWAY_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
POSTGRES_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
REDIS_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
PROMETHEUS_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
GRAFANA_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS

# Generate URL-safe values with:
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_PASSWORD
GRAFANA_ADMIN_USER=REPLACE_WITH_ADMIN_USERNAME
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_URL_SAFE_PASSWORD

# Host directories, owned by UID 1000 and mode 0700. POLICY_DIR_HOST must contain
# policy.yaml; AUDIT_SIGNING_KEY_DIR must contain audit_signing_key.pem.
POLICY_DIR_HOST=/replace/with/absolute/policy-directory
AUDIT_SIGNING_KEY_DIR=/replace/with/absolute/audit-signing-key-directory

# One namespace per PortunusMCP deployment sharing a Docker daemon.
UPSTREAM_RUNTIME_NAMESPACE=portunusmcp-prod
DOCKER_GID=REPLACE_WITH_DOCKER_SOCKET_GID

# The gateway is loopback-only; terminate TLS in an operator-managed reverse proxy.
GATEWAY_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
# Native Uvicorn comma-separated IP/CIDR allowlist for trusted proxy headers.
# "*" is safe only while the shipped loopback binding and trusted-host boundary hold.
FORWARDED_ALLOW_IPS=REPLACE_WITH_PROXY_IP_OR_CIDR
ALLOWED_HOSTS=["gateway.example.com"]
ALLOWED_ORIGINS=[]

# Resource, lifecycle, and security settings are explicit in production.
MAX_MCP_BODY_BYTES=1048576
MAX_JSON_DEPTH=32
MAX_SESSIONS_PER_IDENTITY=3
MAX_INFLIGHT_CALLS_PER_IDENTITY=5
TOOL_CALL_RATE_LIMIT=60
TOOL_CALL_RATE_WINDOW_SECONDS=60
AUTH_FAILURE_RATE_LIMIT=5
AUTH_FAILURE_RATE_WINDOW_SECONDS=300
TOOL_CALL_DEADLINE_SECONDS=60
READINESS_TIMEOUT_SECONDS=1.0
SCHEMA_CACHE_TTL=600
SESSION_IDLE_TTL=300
SHUTDOWN_GRACE_SECONDS=5
REPLAY_WINDOW_SECONDS=30
BUSINESS_HOURS_START_UTC=9
BUSINESS_HOURS_END_UTC=18
RISK_FREQ_WINDOW_SECONDS=60
RISK_FREQ_THRESHOLD=10
RISK_DECAY_STEP=5
RISK_DECAY_MAX=10
RISK_DECAY_TTL_SECONDS=2592000
RISK_DENIAL_WINDOW_SECONDS=600
RISK_DENIAL_THRESHOLD=3
RISK_DRIFT_HISTORY_WINDOW_SECONDS=604800
RISK_DRIFT_HISTORY_THRESHOLD=2
DRIFT_DESCRIPTION_SEVERITY=high
APPROVAL_TTL_SECONDS=900
STEP_UP_TTL_SECONDS=300
VERIFY_INTERVAL_SECONDS=60
