# Production gateway-only secrets. Copy to .env.prod.gateway and chmod 0600.
# Add only environment variables referenced by the active policy:
# - PORTUNUSMCP_UPSTREAM_* values used by server env mappings
# - signed identity HMAC secrets
# - TOTP secrets
#
# Example:
# PORTUNUSMCP_UPSTREAM_GITHUB_TOKEN=replace-me
# PORTUNUSMCP_CI_SIGNING_SECRET=replace-me
# PORTUNUSMCP_OPS_TOTP_SECRET=replace-me
